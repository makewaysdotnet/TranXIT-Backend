{
	email {$CADDY_ACME_EMAIL}
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(auth_api_rate_limit) {
	rate_limit {
		zone auth_api {
			match {
				method POST
				path /api/auth/* /api/login /api/login/google /api/register /api/send-code /api/reset-password
			}
			key {remote_host}
			events {$AUTH_RATE_LIMIT_EVENTS}
			window {$AUTH_RATE_LIMIT_WINDOW}
			ipv6_prefix 64
		}
		log_key
	}
}

(tranxit_routes) {
	handle /api/* {
		import auth_api_rate_limit
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

(tranxit_site) {
	import security_headers
	encode zstd gzip
	log {
		output stdout
		format json
	}
	import tranxit_routes
}

(public_tranxit_site) {
	import security_headers
	encode zstd gzip
	log {
		output stdout
		format json
	}
	@admitted file {
		root /run/tranxit/admission
		try_files open
	}
	handle @admitted {
		import tranxit_routes
	}
	handle {
		header Retry-After "60"
		respond "Temporarily unavailable" 503
	}
}

(mailpit_site) {
	import security_headers
	encode zstd gzip

	log {
		output stdout
		format json
	}

	basic_auth {
		{$MAILPIT_BASIC_AUTH_USER} {$MAILPIT_BASIC_AUTH_HASH}
	}

	handle {
		reverse_proxy mailpit:8025
	}
}

{$DOMAIN} {
	import public_tranxit_site
}

{$STAGING_DOMAIN} {
	import public_tranxit_site
}

http://:8082 {
	import tranxit_site
}

{$MAILPIT_DOMAIN} {
	import mailpit_site
}
