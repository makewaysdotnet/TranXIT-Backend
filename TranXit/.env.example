# Copy this file to .env and fill in local-only values.
# Do not commit .env or real production credentials.

TRANXIT_SA_PASSWORD=
TRANXIT_JWT_SECRET=
TRANXIT_RABBITMQ_USERNAME=
TRANXIT_RABBITMQ_PASSWORD=
TRANXIT_GATEWAY_PORT=8088
TRANXIT_SQL_PORT=1433
TRANXIT_RABBITMQ_PORT=5672
TRANXIT_RABBITMQ_MANAGEMENT_PORT=15672

# Production/staging deployment placeholders only.
# Real values must be generated on the VPS and written to /opt/tranxit/.env.
TRANXIT_IMAGE_TAG=
TRANXIT_DEPLOY_ENV=
TRANXIT_FRONTEND_BUILD_CONTEXT=
DOMAIN=
STAGING_DOMAIN=
PUBLIC_APP_URL=
STAGING_APP_URL=
NEXT_PUBLIC_TRANXIT_API_URL=
TRANXIT_INTERNAL_API_URL=
TRANXIT_EGRESS_PROBE_URL=
TRANXIT_BACKUP_DIR=
TRANXIT_BACKUP_RETENTION_DAYS=
TRANXIT_MARKER_DIR=
# Production compose requires this host directory; deploy/backup/restore derive it from the marker directory.
TRANXIT_ADMISSION_DIR=
CADDY_ACME_EMAIL=
AUTH_RATE_LIMIT_EVENTS=
AUTH_RATE_LIMIT_WINDOW=
SQL_SA_PASSWORD=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRY_MINUTES=
JWT_REFRESH_EXPIRY_DAYS=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_SENDER_NAME=
ADMIN_EMAIL=
SMOKE_LOGIN_EMAIL=
SMOKE_LOGIN_PASSWORD=

# Staging-only Mailpit capture. Leave unset for production.
MAILPIT_DOMAIN=
MAILPIT_BASIC_AUTH_USER=
MAILPIT_BASIC_AUTH_HASH=
TRANXIT_E2E_MAIL_INBOX=
TRANXIT_E2E_MAIL_INBOX_USER=
TRANXIT_E2E_MAIL_INBOX_PASSWORD=
TRANXIT_MAILPIT_INTERNAL_URL=
